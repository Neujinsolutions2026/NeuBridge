# Postgres connection string (Neon). Get it from your Neon project's
# dashboard, or from Netlify's environment variables once connected there.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign session tokens. Generate a real one for
# production with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

AUTH_TRUST_HOST="true"

# The public URL of the deployed app - used to build links in notification
# emails (e.g. "View in Neubridge"). Falls back to localhost in dev.
# APP_URL="https://your-app.netlify.app"

# Set automatically by Netlify once file uploads run there (NETLIFY=true is
# always present in Netlify's own build/runtime environments). Without it,
# file uploads (message attachments) fall back to local disk, which only
# works in dev / on a persistent server.
# NETLIFY="true"

# Sends an email alongside every in-app notification (new message, document
# received, task delay, etc.) via Resend - https://resend.com. Without a
# key, emails are skipped silently; the in-app notification still works.
# RESEND_API_KEY="re_..."
# "Display Name <address@yourdomain.com>" - the address needs to be on a
# domain you've verified in Resend to send to arbitrary recipients. Without
# a verified domain, Resend only delivers to your own account's email.
# EMAIL_FROM="Neubridge <notifications@yourdomain.com>"

# One-time production admin account, used only by `npm run db:seed:admin`
# (see prisma/seed-admin.ts). Not needed for the app to run - only for
# creating the first login after a fresh deploy.
# ADMIN_NAME="Your Name"
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="choose-a-strong-password"
