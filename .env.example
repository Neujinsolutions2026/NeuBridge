# Postgres connection string. In production, Vercel injects this
# automatically once you connect a Postgres database under the project's
# Storage tab - you shouldn't need to set it by hand there.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign session tokens. Generate a real one for
# production with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# The public URL of the deployed app (used by next-auth for redirects).
# On Vercel this can usually be left unset - it's inferred automatically.
# AUTH_URL="https://your-app.vercel.app"

# Set automatically by Vercel once you connect a Blob store under the
# project's Storage tab. Without it, file uploads (message attachments)
# fall back to local disk, which only works in dev / on a persistent server.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# One-time production admin account, used only by `npm run db:seed:admin`
# (see prisma/seed-admin.ts). Not needed for the app to run - only for
# creating the first login after a fresh deploy.
# ADMIN_NAME="Your Name"
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="choose-a-strong-password"
